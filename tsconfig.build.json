{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "apps/api/src/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "packages/kernel/src/**/*.ts",
    "packages/platform-identity/src/**/*.ts",
    "packages/platform-db/src/**/*.ts",
    "packages/domain-scheduling/src/**/*.ts",
    "packages/domain-booking/src/**/*.ts",
    "packages/domain-appearance/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "dist",
    "node_modules"
  ]
}
