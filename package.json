{
  "name": "cookie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker:synthetic": "tsx apps/api/src/synthetic-worker-main.ts",
    "worker:synthetic": "node dist/apps/api/src/synthetic-worker-main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "test": "tsx --test apps/api/test/*.unit.test.ts packages/contracts/test/*.unit.test.ts packages/kernel/test/*.unit.test.ts packages/platform-identity/test/*.unit.test.ts packages/domain-scheduling/test/*.unit.test.ts && node --test scripts/f1-chromium-startup.test.mjs",
    "test:integration": "tsx --test --test-concurrency=1 apps/api/test/*.integration.test.ts",
    "db:migrate": "tsx packages/platform-db/src/cli.ts",
    "start:api": "node dist/apps/api/src/main.js",
    "dev:web": "pnpm --filter @cookie/web dev",
    "build:web": "pnpm --filter @cookie/web build",
    "typecheck:web": "pnpm --filter @cookie/web check",
    "check:boundaries": "node scripts/check-boundaries.mjs && node --test scripts/check-boundaries.test.mjs",
    "check:ui": "node apps/web/scripts/check-ui-structure.mjs",
    "build:runtime": "pnpm build && node scripts/link-runtime-modules.mjs && VITE_COOKIE_DATA_MODE=api pnpm build:web"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.15.5",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
